TDS_ROOT=/opt/tds/TDS
TDS_BASE_URL=http://127.0.0.1:8080
TDS_USE_DASHBOARD_SETTINGS=true
POSTGRES_DB=tds
POSTGRES_USER=tds
POSTGRES_PASSWORD=tds_dev_password
TDS_API_BIND_HOST=127.0.0.1
TDS_DATABASE_URL=postgresql+psycopg://tds:tds_dev_password@postgres:5432/tds
TDS_INGEST_API_KEY=change-me
TDS_MQTT_HOST=mqtt
TDS_MQTT_PORT=1883
TDS_MQTT_ENABLED=true
TDS_CONTROL_URL=http://control:8090
TDS_CONTROL_TIMEOUT_SECONDS=3.0
TDS_OPENWRT_URL=https://192.0.2.1/ubus
TDS_OPENWRT_USERNAME=tds
TDS_OPENWRT_PASSWORD=replace-with-long-random-password
TDS_OPENWRT_VERIFY_TLS=false
TDS_UNIFI_URL=
TDS_UNIFI_API_KEY=replace-with-unifi-api-key
TDS_UNIFI_SITE_ID=
TDS_UNIFI_VERIFY_TLS=true
TDS_UNIFI_WEBHOOK_TOKEN=replace-with-long-random-token
TDS_KISMET_URL=http://127.0.0.1:2501
TDS_KISMET_USERNAME=tds
TDS_KISMET_PASSWORD=replace-with-kismet-password
TDS_KISMET_VERIFY_TLS=false
TDS_KISMET_RECENT_SECONDS=60
TDS_BLE_ANALYZER_CAPTURE_SECONDS=8
TDS_BLE_ANALYZER_PCAP_DIR=/var/log/tds/ble-analyzer
TDS_BLE_ANALYZER_SENSOR_ID=wch_ble_analyzer
TDS_BLE_ANALYZER_ZONE=rf-passive
TDS_RAIL_RTL_DEVICE=auto
TDS_RAIL_RF_ZONE=rf-passive
TDS_RAIL_RF_SCAN_SECONDS=8
TDS_RAIL_RF_BIN_WIDTH_HZ=10000
TDS_RAIL_RF_POWER_FLOOR=-80
TDS_RAIL_RF_CATALOG=config/rail_channels.local.json
TDS_INTERCEPT_URL=http://127.0.0.1:5050
TDS_INTERCEPT_USERNAME=tds
TDS_INTERCEPT_PASSWORD=replace-with-intercept-password
TDS_INTERCEPT_VERIFY_TLS=false
TDS_LTESNIFFER_ENABLED=false
TDS_LTESNIFFER_MODE=probe
TDS_LTESNIFFER_BINARY=/opt/tds/ltesniffer/build/src/LTESniffer
TDS_LTESNIFFER_WORKDIR=/var/log/tds/ltesniffer
TDS_LTESNIFFER_SENSOR_ID=libresdr_b210
TDS_LTESNIFFER_ZONE=cellular-lab
TDS_LTESNIFFER_UHD_ARGS=num_recv_frames=512
TDS_LTESNIFFER_DL_FREQ_HZ=
TDS_LTESNIFFER_UL_FREQ_HZ=
TDS_LTESNIFFER_CELL_ID=
TDS_LTESNIFFER_PRB=
TDS_LTESNIFFER_ANTENNAS=2
TDS_LTESNIFFER_WORKERS=4
TDS_LTESNIFFER_API_MODE=
TDS_LTESNIFFER_RUN_SECONDS=20
TDS_LTESNIFFER_UNMASK_IDENTITIES=false
