{
  "name": "tds-3d-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc -b && TDS_BUILD_SHA=$(git rev-parse --short HEAD 2>/dev/null || echo local) vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "mock-backend": "node scripts/mock-tds-backend.mjs",
    "dev:mock": "TDS_DEV_BACKEND=http://127.0.0.1:8787 vite --host 127.0.0.1"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/uikit": "1.0.74",
    "@react-three/xr": "6.6.31",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "5.0.3"
  }
}
