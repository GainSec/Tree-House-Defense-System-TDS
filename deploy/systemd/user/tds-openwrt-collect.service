[Unit]
Description=TDS OpenWrt observation collector
Documentation=file:@TDS_ROOT@/docs/openwrt.md

[Service]
Type=oneshot
WorkingDirectory=@TDS_ROOT@
EnvironmentFile=@TDS_ROOT@/.env
Environment=TDS_USE_DASHBOARD_SETTINGS=true
ExecStart=@TDS_ROOT@/.venv/bin/python tools/openwrt_collect.py
TimeoutStartSec=25s
StandardOutput=null
StandardError=journal
