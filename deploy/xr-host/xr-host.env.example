# Copy to xr-host.env (never commit it) and replace every value.
TDS_POSTGRES_PASSWORD=change-me-postgres
TDS_INGEST_API_KEY=change-me-ingest-key
# Optional login page. TDS is meant to be hosted locally, so it is off by default.
TDS_GATEWAY_AUTH=off
# Only used when TDS_GATEWAY_AUTH=on: the password, and a random 32+ character cookie-signing secret.
TDS_GATEWAY_PASSWORD=
TDS_GATEWAY_SECRET=
# Which writes the gateway forwards: "none", "presence" (watchlist/notes/decisions/enrichment), or "all".
TDS_GATEWAY_ALLOW_WRITES=presence
TDS_GATEWAY_PUBLIC_PORT=8089
# Your HTTPS reverse proxy's IP(s), comma-separated. Without it, every proxied client
# shares the proxy's address for login rate limiting.
TDS_GATEWAY_TRUSTED_PROXIES=
